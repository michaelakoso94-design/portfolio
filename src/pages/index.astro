---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import AsciiField from '../components/AsciiField.astro';
import Cover from '../components/Cover.astro';

const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((p) => p.data.featured);
const other = all.filter((p) => !p.data.featured);
---
<Base>
  <section class="hero wrap">
    <p class="mono kicker"><span class="smile">☺</span> Welcome to my playground</p>
    <h1>
      Hi, I'm Michaela.<br />
      A product designer who <em>designs</em> and <em>codes.</em>
    </h1>
    <div class="intro">
      <p>
        I work across research, interaction, visual systems and front-end. My projects live in
        digital products, interactive experiences and physical spaces.
      </p>
      <div class="cta">
        <a class="btn" href="#work">See my work ↓</a>
        <a class="btn ghost" href="#contact">Get in touch</a>
      </div>
    </div>
  </section>

  <section class="wrap field">
    <AsciiField word="KOSO" />
  </section>

  <section class="wrap skills reveal">
    <div><span class="mono">01</span><h3>Product design</h3><p>Research, information architecture and UX/UI for products people use every day.</p></div>
    <div><span class="mono">02</span><h3>Creative coding</h3><p>Interactive experiences where code is part of the concept, not just the build.</p></div>
    <div><span class="mono">03</span><h3>Front-end</h3><p>I take my own designs to production, so what ships is what was designed.</p></div>
  </section>

  <section id="work" class="wrap work">
    <div class="head reveal">
      <h2>Selected work</h2>
      <span class="mono">{featured.length} case studies</span>
    </div>

    <ol class="list">
      {featured.map((p, i) => (
        <li class="reveal">
          <a href={`/work/${p.id}`} class="item" data-accent={p.data.accent}>
            <span class="num mono">{String(i + 1).padStart(2, '0')}</span>
            <div class="thumb"><Cover src={p.data.cover} title={p.data.title} accent={p.data.accent} /></div>
            <div class="txt">
              <div class="meta mono">{p.data.client}{p.data.year && ` · ${p.data.year}`}</div>
              <h3>{p.data.title}</h3>
              <p>{p.data.hook}</p>
              <div class="tags">
                {p.data.badge && <span class="tag badge">★ {p.data.badge}</span>}
                {p.data.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            </div>
            <span class="go mono">Read case study <span class="arr">→</span></span>
          </a>
        </li>
      ))}
    </ol>

    {other.length > 0 && (
      <div class="other reveal">
        <h3 class="mono">Other work</h3>
        <ul>
          {other.map((p) => (
            <li><a href={`/work/${p.id}`}><strong>{p.data.title}</strong><span>{p.data.hook}</span><span class="arr">→</span></a></li>
          ))}
          <li>
            <a href="https://www.figma.com/proto/K1h5LXSuAhjpA8fvwHtSaZ/Monday-persomal-status-indicator?node-id=0-1107&viewport=362%2C60%2C0.03&t=0TGCyrwMQf9ZjxTB-1&scaling=scale-down-width&content-scaling=fixed&page-id=0%3A1" target="_blank" rel="noopener">
              <strong>Personal Status Indicator</strong><span>Advanced UX course, Figma prototype</span><span class="arr">↗</span>
            </a>
          </li>
        </ul>
      </div>
    )}
  </section>
</Base>

<style>
  .hero { padding-top: clamp(48px, 9vw, 120px); padding-bottom: clamp(32px, 5vw, 56px); }
  .kicker { color: var(--ink-2); margin: 0 0 24px; display: flex; align-items: center; gap: 8px; }
  .smile { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--accent); color: var(--ink); font-size: 15px; }
  h1 {
    font-size: clamp(40px, 7.4vw, 104px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    font-weight: 600;
    margin: 0 0 clamp(28px, 4vw, 48px);
    max-width: 14ch;
  }
  h1 em { font-family: var(--serif); font-weight: 400; letter-spacing: -0.01em; }
  .intro { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; flex-wrap: wrap; }
  .intro p { max-width: 46ch; margin: 0; font-size: clamp(17px, 1.6vw, 20px); color: var(--ink-2); }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; }

  .field { margin-bottom: 72px; }

  .skills { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; padding-bottom: clamp(64px, 10vw, 120px); }
  .skills h3 { font-size: 22px; margin: 10px 0 8px; letter-spacing: -0.01em; }
  .skills p { margin: 0; color: var(--ink-2); font-size: 16px; }
  .skills .mono { color: var(--ink-2); }
  @media (max-width: 760px) { .skills { grid-template-columns: 1fr; gap: 24px; } }

  .work { scroll-margin-top: 80px; }
  .head { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid var(--ink); padding-bottom: 14px; }
  .head h2 { font-size: clamp(28px, 4vw, 44px); margin: 0; letter-spacing: -0.02em; font-weight: 600; }
  .head .mono { color: var(--ink-2); }

  .list { list-style: none; margin: 0; padding: 0; }
  .list li { border-bottom: 1px solid var(--line); }
  .item {
    display: grid;
    grid-template-columns: 48px minmax(200px, 340px) 1fr auto;
    gap: clamp(16px, 3vw, 40px);
    align-items: center;
    padding: clamp(24px, 3vw, 36px) 0;
    text-decoration: none;
    position: relative;
  }
  .num { color: var(--ink-2); align-self: start; padding-top: 6px; }
  .thumb { transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  .item:hover .thumb { transform: scale(1.03) rotate(-0.6deg); }
  .meta { color: var(--ink-2); margin-bottom: 8px; font-size: 11px; }
  .txt h3 { font-size: clamp(26px, 3.2vw, 40px); line-height: 1.05; margin: 0 0 10px; letter-spacing: -0.025em; font-weight: 600; }
  .txt p { margin: 0 0 16px; color: var(--ink-2); max-width: 44ch; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .go { white-space: nowrap; align-self: end; padding-bottom: 4px; }
  .arr { display: inline-block; transition: transform .3s ease; }
  .item:hover .arr { transform: translateX(6px); }
  .item:hover h3 { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }

  @media (max-width: 900px) {
    .item { grid-template-columns: 1fr; gap: 16px; }
    .num { display: none; }
    .go { align-self: start; }
  }

  .other { margin-top: 64px; }
  .other h3 { color: var(--ink-2); margin: 0 0 8px; font-weight: 500; }
  .other ul { list-style: none; padding: 0; margin: 0; }
  .other li { border-top: 1px solid var(--line); }
  .other li:last-child { border-bottom: 1px solid var(--line); }
  .other a { display: grid; grid-template-columns: 260px 1fr auto; gap: 20px; padding: 16px 0; text-decoration: none; align-items: baseline; }
  .other a:hover strong { text-decoration: underline; }
  .other span { color: var(--ink-2); }
  .other a:hover .arr { transform: translateX(6px); }
  @media (max-width: 700px) { .other a { grid-template-columns: 1fr auto; } .other a span:not(.arr) { grid-column: 1; } }
</style>
