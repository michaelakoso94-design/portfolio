---
// Shows the project image when there is one, otherwise a typographic placeholder.
interface Props { src?: string; title: string; accent?: string; ratio?: string; }
const { src, title, accent = '#ffd60a', ratio = '4 / 3' } = Astro.props;
---
<div class="cover" style={`--a:${accent}; aspect-ratio:${ratio}`}>
  {src ? (
    <img src={src} alt={`${title} preview`} loading="lazy" decoding="async" />
  ) : (
    <div class="ph">
      <span class="mono">image coming soon</span>
      <strong>{title}</strong>
    </div>
  )}
</div>

<style>
  .cover { position: relative; overflow: hidden; border-radius: 6px; background: var(--paper); }
  img { width: 100%; height: 100%; object-fit: cover; }
  .ph {
    position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: space-between;
    padding: 18px; background:
      repeating-linear-gradient(90deg, transparent 0 11px, #00000010 11px 12px),
      var(--a);
  }
  .ph strong { font-size: clamp(22px, 3vw, 34px); line-height: 1; letter-spacing: -0.02em; }
  .ph .mono { font-size: 10px; opacity: .7; }
</style>
