---
const email = 'michaelakoso94@gmail.com';
---
<footer id="contact" class="contact">
  <div class="wrap">
    <p class="mono kicker">Let's talk</p>
    <h2>Have a product that needs<br /><em>both design and code?</em></h2>
    <div class="actions">
      <button class="btn copy" data-email={email} type="button">
        <span class="label">{email}</span>
        <span class="mono hint">Copy</span>
      </button>
      <a class="btn ghost" href={`mailto:${email}`}>Email me</a>
      <a class="btn ghost" href="https://www.linkedin.com/in/michaela-koso-4162a818a/" target="_blank" rel="noopener">LinkedIn</a>
    </div>
    <div class="bottom">
      <span>© {new Date().getFullYear()} Michaela Kosovsky</span>
      <span class="socials">
        <a href="https://www.instagram.com/michaelakoso/" target="_blank" rel="noopener">Instagram</a>
        <a href="#top" onclick="window.scrollTo({top:0});return false;">Back to top ↑</a>
      </span>
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy').forEach((b) => {
    b.addEventListener('click', async () => {
      const hint = b.querySelector('.hint')!;
      try {
        await navigator.clipboard.writeText(b.dataset.email || '');
        hint.textContent = 'Copied ✓';
      } catch {
        window.location.href = `mailto:${b.dataset.email}`;
      }
      setTimeout(() => (hint.textContent = 'Copy'), 1800);
    });
  });
</script>

<style>
  .contact { background: var(--ink); color: var(--bg); padding: clamp(72px, 12vw, 140px) 0 32px; margin-top: 120px; }
  .kicker { color: var(--accent); margin: 0 0 18px; }
  h2 { font-size: clamp(34px, 6vw, 72px); line-height: 1.02; margin: 0 0 40px; font-weight: 600; letter-spacing: -0.02em; }
  h2 em { font-family: var(--serif); font-weight: 400; font-style: italic; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .contact .btn { background: var(--bg); color: var(--ink); border-color: var(--bg); }
  .contact .btn.ghost { background: transparent; color: var(--bg); }
  .contact .btn.ghost:hover { background: var(--bg); color: var(--ink); }
  .hint { opacity: .55; font-size: 11px; }
  .label { word-break: break-all; }
  .bottom { margin-top: 96px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; font-size: 14px; color: #a39e93; }
  .socials { display: flex; gap: 20px; }
  .socials a { text-decoration: none; }
  .socials a:hover { color: var(--bg); }
</style>
